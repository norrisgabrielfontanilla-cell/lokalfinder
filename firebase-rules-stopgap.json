{
  "rules": {
    ".read": true,
    "lokalfinder_grass": {
      "vendors":   { "$vid": { ".write": true } },
      "menu":      { "$vid": { ".write": true } },
      "pinHashes": { "$vid": { ".write": true } },
      "orders":    { ".write": true, ".indexOn": ["vendorId"] },
      "posts":     { ".write": true, ".indexOn": ["createdAt"] },
      "$other":    { ".write": true }
    },

    "$room": {
      "vendors":   { "$vid": { ".write": "$room.matches(/^lf_c_[a-z0-9][a-z0-9-]{1,62}$/)" } },
      "menu":      { "$vid": { ".write": "$room.matches(/^lf_c_[a-z0-9][a-z0-9-]{1,62}$/)" } },
      "pinHashes": { "$vid": { ".write": "$room.matches(/^lf_c_[a-z0-9][a-z0-9-]{1,62}$/)" } },
      "orders":    { ".write": "$room.matches(/^lf_c_[a-z0-9][a-z0-9-]{1,62}$/)", ".indexOn": ["vendorId"] },
      "posts":     { ".write": "$room.matches(/^lf_c_[a-z0-9][a-z0-9-]{1,62}$/)", ".indexOn": ["createdAt"] },
      "$other":    { ".write": "$room.matches(/^lf_c_[a-z0-9][a-z0-9-]{1,62}$/)" }
    },

    "condoPipeline": {
      "$cid": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()",
        "stage": {
          ".validate": "newData.isString() && newData.val().matches(/^(researching|next|talks|launching|live|hold|closed)$/) && (!data.exists() || newData.parent().child('prevStage').val() === data.val())"
        },
        "prevStage": {
          ".validate": "newData.isString() && newData.val().matches(/^(researching|next|talks|launching|live|hold|closed)$/)"
        },
        "stageAt": {
          ".validate": "newData.isNumber()"
        },
        "touchedAt": {
          ".validate": "newData.isNumber()"
        },
        "liveAt": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "launchTarget": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "nextDue": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "nextAction": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "condoLog": {
      "$lid": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['condo','at','from','to','by'])",
        "condo": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9][a-z0-9-]{1,62}$/)"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "from": {
          ".validate": "newData.isString() && newData.val().matches(/^(researching|next|talks|launching|live|hold|closed)$/)"
        },
        "to": {
          ".validate": "newData.isString() && newData.val().matches(/^(researching|next|talks|launching|live|hold|closed)$/)"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "by": {
          ".validate": "newData.isString() && newData.val() === 'admin'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "condoTargets": {
      "$year": {
        ".write": true,
        ".validate": "$year.matches(/^20[0-9]{2}$/) && newData.hasChildren(['live'])",
        "live": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "condoDirectory": {
      "$cid": {
        ".write": "newData.exists() || data.exists()",
        ".validate": "$cid.matches(/^[a-z0-9][a-z0-9-]{1,62}$/) && !$cid.matches(/^(sample|preview)-/) && $cid != 'grass-residences-quezon-city' && newData.hasChildren(['name','status','visible','confidence','createdAt','updatedAt'])",
        "name":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "city":       { ".validate": "newData.isString() && newData.val().length <= 80" },
        "developer":  { ".validate": "newData.isString() && newData.val().length <= 80" },
        "barangay":   { ".validate": "newData.isString() && newData.val().length <= 80" },
        "address":    { ".validate": "newData.isString() && newData.val().length <= 160" },
        "siteNote":   { ".validate": "newData.isString() && newData.val().length <= 300" },
        "unitHint":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "status":     { ".validate": "newData.isString() && newData.val().matches(/^(live|coming|closed)$/)" },
        "visible":    { ".validate": "newData.isBoolean()" },
        "confidence": { ".validate": "newData.isString() && newData.val().matches(/^(confirmed|likely|unverified)$/)" },
        "verifiedAt": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "createdAt":  { ".validate": "newData.isNumber()" },
        "updatedAt":  { ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())" },
        "lat":        { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng":        { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "aliases":    { "$i": { ".validate": "newData.isString() && newData.val().length <= 80" } },
        "landmarks":  { "$i": { ".validate": "newData.isString() && newData.val().length <= 80" } },
        "source":     { "$i": { ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^https:[/][/][^ ]+$/)" } },
        "buildings": {
          "$bid": {
            ".validate": "$bid.matches(/^[a-z0-9][a-z0-9_-]{0,30}$/) && newData.hasChildren(['name','kind','order'])",
            "name":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "kind":  { ".validate": "newData.isString() && newData.val().matches(/^(tower|building|wing|phase|block|villa|podium|other)$/)" },
            "order": { ".validate": "newData.isNumber()" },
            "floors": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 150" },
            "note":  { ".validate": "newData.isString() && newData.val().length <= 120" },
            "sitePos": {
              "row":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40" },
              "col":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40" },
              "podium": { ".validate": "newData.isString() && newData.val().length <= 12" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "condoDirRev": {
      ".write": "newData.exists()",
      ".validate": "newData.isNumber() && newData.val() > 0"
    }
  }
}
